#!/usr/bin/env bash

set -euo pipefail

# Check that $HOME is set
if [ -z "${HOME:-}" ]; then
	echo "❌ HOME is unset or empty!"
	exit 1
fi

# Check dependencies
REQUIRED_CMDS=(
	wget
	wine
	wineboot
	winetricks
	sed
	cp
	mkdir
	chmod
	rm
	mv
	mktemp
	convert
)

MISSING=()

for cmd in "${REQUIRED_CMDS[@]}"; do
	if ! command -v "$cmd" >/dev/null 2>&1; then
		MISSING+=("$cmd")
	fi
done

if [ "${#MISSING[@]}" -ne 0 ]; then
	echo "❌ Missing dependencies:"
	for cmd in "${MISSING[@]}"; do
		echo "  - $cmd"
	done
	echo

	echo "Install the missing dependencies using your package manager:"
	echo

	# Map command names to package names
	declare -A PACKAGES=(
		[convert]="imagemagick"
	)

	APT_PACKAGES=()
	DFN_PACKAGES=()
	PACMAN_PACKAGES=()

	for cmd in "${MISSING[@]}"; do
		package="${PACKAGES[$cmd]:-$cmd}"
		APT_PACKAGES+=("$package")
		DFN_PACKAGES+=("$package")
		PACMAN_PACKAGES+=("$package")
	done

	echo "Debian / Ubuntu / Linux Mint:"
	echo "	sudo apt update && sudo apt install ${APT_PACKAGES[*]}"
	echo
	echo "Fedora:"
	echo "	sudo dnf install ${DFN_PACKAGES[*]}"
	echo
	echo "Arch:"
	echo "	sudo pacman -S ${PACMAN_PACKAGES[*]}"
	echo

	exit 1
fi

echo "✅ All dependencies found."

# Create temporary directory and clean it up on exit
TMP_DIR="$(mktemp -d)"
trap 'rm -rf "$TMP_DIR"' EXIT

# Create a desktop entry
create_desktop_entry() {
	local desktop_file="$1"
	local executable="$HOME/Applications/Windows/Guitar-Pro-8/drive_c/Program Files/Arobas Music/Guitar Pro 8/GuitarPro.exe"
	local prefix="$HOME/Applications/Windows/Guitar-Pro-8"
	local version=""

	if command -v exiftool >/dev/null 2>&1; then
		version="$(exiftool -s3 -ProductVersion "$executable" 2>/dev/null || true)"
	fi

	{
		echo "[Desktop Entry]"
		echo "Type=Application"
		echo "Name=Guitar Pro 8"
		echo "Comment=Run Guitar Pro 8 under Wine."

		if [ -n "$version" ]; then
			echo "X-App-Version=$version"
		fi

		echo "Terminal=false"
		printf 'Exec=env WINEPREFIX="%s" wine "%s"\n' \
			"$prefix" "$executable"
		echo "Icon=guitar-pro-8"
		echo "Categories=AudioVideo;Music;"
	} >"$desktop_file"

	chmod +x "$desktop_file"
}

# Download required files before modifying the existing installation
echo "ℹ️ Downloading installation files..."

for script in startup reset reset-and-startup; do
	wget -q -O "$TMP_DIR/$script" "https://gp8.nikoboi.dev/$script"
done

# Preserve the existing installer, or download it if missing
echo "ℹ️ Preserving or downloading the Guitar Pro 8 installer..."

if [ -f "$HOME/Applications/Windows/Guitar-Pro-8/guitar-pro-8-setup.exe" ]; then
	cp -f "$HOME/Applications/Windows/Guitar-Pro-8/guitar-pro-8-setup.exe" "$TMP_DIR/guitar-pro-8-setup.exe"
else
	wget -O "$TMP_DIR/guitar-pro-8-setup.exe" "https://downloads.guitar-pro.com/gp8/stable/guitar-pro-8-setup.exe"
fi

# Recreate Wine prefix
echo "ℹ️ Recreating Wine prefix..."

rm -rf "$HOME/Applications/Windows/Guitar-Pro-8"
mkdir -p "$HOME/Applications/Windows/Guitar-Pro-8"

cp -f "$TMP_DIR/guitar-pro-8-setup.exe" \
	"$HOME/Applications/Windows/Guitar-Pro-8/guitar-pro-8-setup.exe"

# Initialize Wine prefix
echo "ℹ️ Initializing Wine prefix..."

WINEARCH=win64 WINEPREFIX="$HOME/Applications/Windows/Guitar-Pro-8" wineboot --init
WINEARCH=win64 WINEPREFIX="$HOME/Applications/Windows/Guitar-Pro-8" winetricks -q win7 corefonts

# Install Guitar Pro 8
echo "ℹ️ Installing Guitar Pro 8..."

if [ ! -f "$HOME/Applications/Windows/Guitar-Pro-8/drive_c/Program Files/Arobas Music/Guitar Pro 8/GuitarPro.exe" ]; then
	WINEARCH=win64 WINEPREFIX="$HOME/Applications/Windows/Guitar-Pro-8" \
		wine "$HOME/Applications/Windows/Guitar-Pro-8/guitar-pro-8-setup.exe"
else
	echo "Guitar Pro 8 is already installed. Skipping installer."
fi

# Remove broken Wine shortcuts
echo "ℹ️ Removing broken Wine desktop entries..."

rm -f "$HOME/Desktop/Guitar Pro 8.desktop"
rm -f "$HOME/.local/share/applications/Guitar Pro 8.desktop"
rm -rf "$HOME/.local/share/applications/wine/Programs/Arobas Music"

# Install desktop entries
echo "ℹ️ Installing desktop entries..."

mkdir -p "$HOME/Desktop" "$HOME/.local/share/applications"

create_desktop_entry \
	"$HOME/.local/share/applications/guitar-pro-8.desktop"

create_desktop_entry \
	"$HOME/Desktop/guitar-pro-8.desktop"

# Install startup scripts
echo "ℹ️ Installing startup scripts..."

for script in startup reset reset-and-startup; do
	cp -f "$TMP_DIR/$script" "$HOME/Applications/Windows/Guitar-Pro-8/$script"
	chmod +x "$HOME/Applications/Windows/Guitar-Pro-8/$script"
done

# Generate hicolor application icons from Guitar Pro's own icon
echo "ℹ️ Generating application icons..."

WINDOWS_USER="${USER:-$(id -un)}"
ICON_SOURCE="$HOME/Applications/Windows/Guitar-Pro-8/drive_c/users/$WINDOWS_USER/AppData/Roaming/Arobas Music/guitarpro8/icon.png"

if [ ! -f "$ICON_SOURCE" ]; then
	echo "❌ Guitar Pro 8's source icon was not found:"
	echo "$ICON_SOURCE"
	exit 1
fi

for size in 32 48 64 128 256; do
	mkdir -p "$HOME/.local/share/icons/hicolor/${size}x${size}/apps"

	convert "$ICON_SOURCE" \
		-resize "${size}x${size}" \
		"$HOME/.local/share/icons/hicolor/${size}x${size}/apps/guitar-pro-8.png"
done

echo
echo "✅ Guitar Pro 8 setup finished!"
echo
echo "Launch Guitar Pro 8 via the Desktop icon or:"
echo "$HOME/Applications/Windows/Guitar-Pro-8/startup"
